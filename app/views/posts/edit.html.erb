<div class="col-md-6 mx-auto">
  <%= bootstrap_form_with(model: [current_user, @post], url: posts_path(@post)) do |f| %>
    <%= f.collection_radio_buttons :store, [["セブンイレブン", "セブンイレブン"], ["ローソン", "ローソン"], ["ファミリーマート", "ファミリーマート"]], :last, :first, inline: true do |b| %>
      <div class="form-check form-check-inline">
        <%= b.radio_button(class: "form-check-input") %>
        <%= b.label(class: "form-check-label") %>
      </div>
    <% end %>

    <%= f.text_field :title %>

    <%= f.file_field :image %>

    <label class="mb-2">使用するコンビニ商品</label>
    <div data-controller="autocomplete">
      <div class="mb-3 position-relative">
        <%= text_field_tag :product_1_search, @post.product_1,
              class: "form-control",
              placeholder: "商品1を入力(必須)",
              data: { autocomplete_target: "input" } %>

        <ul class="list-group position-absolute w-100 z-1000"
            data-autocomplete-target="suggestions"></ul>

        <%= f.hidden_field :product_1 %>
      </div>

      <div class="mb-3 position-relative">
        <%= text_field_tag :product_2_search, @post.product_2,
              class: "form-control",
              placeholder: "商品2を入力(任意)",
              data: { autocomplete_target: "input" } %>

        <ul class="list-group position-absolute w-100 z-1000"
            data-autocomplete-target="suggestions"></ul>

        <%= f.hidden_field :product_2 %>
      </div>

      <div class="mb-3 position-relative">
        <%= text_field_tag :product_3_search, @post.product_3,
              class: "form-control",
              placeholder: "商品3を入力(任意)",
              data: { autocomplete_target: "input" } %>

        <ul class="list-group position-absolute w-100 z-1000"
            data-autocomplete-target="suggestions"></ul>

        <%= f.hidden_field :product_3 %>
      </div>
    </div>

    <label class="mb-2">その他の材料</label>
    <div class="row">
      <% 6.times do |i| %>
        <div class="col-md-6 mb-2">
          <%= text_field_tag "post[other_ingredients][]", "",
                class: "form-control",
                placeholder: "材料（任意）" %>
        </div>
      <% end %>
    </div>

    <%= f.text_area :steps %>
    
    <div class="text-center">
      <%= f.primary "更新する" %>
    </div>
  <% end %>
</div>
