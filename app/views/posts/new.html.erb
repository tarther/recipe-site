<div class="col-md-6 col-sm-9 mx-auto">
  <%= bootstrap_form_with(model: [current_user, @post], url: posts_path(@post)) do |f| %>

    <div data-controller="autocomplete">
      <label class="mb-2">コンビニチェーン</label>
      <div class="form-check form-check-inline mb-2">
        <%= f.radio_button :store, "セブンイレブン", true, class: "form-check-input", data: { autocomplete_target: "store" } %>
      </div>
      <div class="form-check form-check-inline mb-2">
        <%= f.radio_button :store, "ローソン", false, class: "form-check-input", data: { autocomplete_target: "store" } %>
      </div>
      <div class="form-check form-check-inline mb-2">
        <%= f.radio_button :store, "ファミリーマート", false, class: "form-check-input", data: { autocomplete_target: "store" } %>
      </div>

      <%= f.text_field :title %>

      <%= f.file_field :image %>
    
      <label class="mb-2">使用するコンビニ商品</label>
      <div class="mb-3 position-relative">
        <%= text_field_tag :product_1_search, "",
              class: "form-control",
              placeholder: "商品1を入力(必須)",
              data: { autocomplete_target: "input" } %>

        <ul class="list-group position-absolute w-100 z-1000"
            data-autocomplete-target="suggestions"></ul>

        <%= f.hidden_field :product_1 %>
      </div>

      <div class="mb-3 position-relative">
        <%= text_field_tag :product_2_search, "",
              class: "form-control",
              placeholder: "商品2を入力(任意)",
              data: { autocomplete_target: "input" } %>

        <ul class="list-group position-absolute w-100 z-1000"
            data-autocomplete-target="suggestions"></ul>

        <%= f.hidden_field :product_2 %>
      </div>

      <div class="mb-3 position-relative">
        <%= text_field_tag :product_3_search, "",
              class: "form-control",
              placeholder: "商品3を入力(任意)",
              data: { autocomplete_target: "input" } %>

        <ul class="list-group position-absolute w-100 z-1000"
            data-autocomplete-target="suggestions"></ul>

        <%= f.hidden_field :product_3 %>
      </div>
    </div>

    <label class="mb-2">その他の材料</label>
    <div class="row">
      <% 6.times do |i| %>
        <div class="col-md-6 col-sm-6 mb-2">
          <%= text_field_tag "post[other_ingredients][]", "",
                class: "form-control",
                placeholder: "材料（任意）" %>
        </div>
      <% end %>
    </div>

    <%= f.text_area :steps, rows: 5 %>
    
    <div class="text-center">
      <%= f.primary "投稿する" %>
    </div>
  <% end %>
  </div>